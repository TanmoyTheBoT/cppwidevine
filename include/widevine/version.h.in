#pragma once

#define WIDEVINE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define WIDEVINE_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define WIDEVINE_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define WIDEVINE_VERSION_STRING "@PROJECT_VERSION@"
#define WIDEVINE_VERSION_FULL "@PROJECT_VERSION@+@GIT_COMMIT_HASH@"

namespace widevine {

constexpr int VERSION_MAJOR = WIDEVINE_VERSION_MAJOR;
constexpr int VERSION_MINOR = WIDEVINE_VERSION_MINOR;
constexpr int VERSION_PATCH = WIDEVINE_VERSION_PATCH;
constexpr const char* VERSION_STRING = WIDEVINE_VERSION_STRING;
constexpr const char* VERSION_FULL = WIDEVINE_VERSION_FULL;

inline const char* get_version() {
    return VERSION_FULL;
}

} // namespace widevine
